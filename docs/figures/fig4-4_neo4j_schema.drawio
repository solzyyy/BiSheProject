<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram name="图4-4 Neo4j属性图模型" id="fig4-4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Event 节点 -->
        <mxCell id="ev" value="&lt;b&gt;:Event&lt;/b&gt;&lt;br&gt;&lt;hr/&gt;id　·　type&lt;br&gt;行动　·　目标　·　结果　·　场景&lt;br&gt;emotion_value　·　conflict_value　·　impact_value&lt;br&gt;is_start　·　is_ending　·　ending_id"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Event 自关联（REL） -->
        <mxCell id="eself" value="REL&lt;br&gt;(type: 因果/时序, 描述)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;exitX=1;exitY=0.3;exitPerimeter=0;entryX=1;entryY=0.7;entryPerimeter=0;"
          edge="1" source="ev" target="ev" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="76" />
              <mxPoint x="420" y="146" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- StateChange 节点 -->
        <mxCell id="sc" value="&lt;b&gt;:StateChange&lt;/b&gt;&lt;br&gt;&lt;hr/&gt;source_event　·　target_type&lt;br&gt;target_id　·　dimension&lt;br&gt;change_type　·　value&lt;br&gt;is_obstacle　·　plot_sensitive"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="280" height="120" as="geometry" />
        </mxCell>

        <!-- Character 节点 -->
        <mxCell id="ch" value="&lt;b&gt;:Character&lt;/b&gt;&lt;br&gt;&lt;hr/&gt;id　·　canonical_name&lt;br&gt;aliases　·　mention_count&lt;br&gt;entity_type"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;"
          vertex="1" parent="1">
          <mxGeometry x="510" y="190" width="260" height="105" as="geometry" />
        </mxCell>

        <!-- 关系：Event → StateChange (TRIGGERS) -->
        <mxCell id="etrig" value="TRIGGERS"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=12;fontStyle=1;strokeColor=#6c8ebf;"
          edge="1" source="ev" target="sc" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 关系：Character → StateChange (HAS_STATE) -->
        <mxCell id="chs1" value="HAS_STATE&lt;br&gt;(target_type=character)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;strokeColor=#82b366;"
          edge="1" source="ch" target="sc" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 关系：Character → StateChange (HAS_RELATIONSHIP_STATE) -->
        <mxCell id="chs2" value="HAS_RELATIONSHIP_STATE&lt;br&gt;(target_type=relationship)"
          style="edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=11;strokeColor=#82b366;dashed=1;"
          edge="1" source="ch" target="sc" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="510" y="420" />
            </Array>
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
